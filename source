<?php
declare(strict_types=1);

/*
 * Sunrise / sunset calendar generator.
 * Compatible with PHP 8.4.
 */

const MAX_CALENDAR_DAYS = 365;
const DEFAULT_TIMEZONE = 'America/Los_Angeles';
const DEFAULT_LATITUDE = 45.59;
const DEFAULT_LONGITUDE = -122.59;
const CALENDAR_URL = 'https://crow.black/ical_sun.php';

function html(string $value): string
{
    return htmlspecialchars(
        $value,
        ENT_QUOTES | ENT_SUBSTITUTE,
        'UTF-8'
    );
}

function postString(string $name, string $default = ''): string
{
    $value = $_POST[$name] ?? $default;

    if (!is_string($value)) {
        throw new InvalidArgumentException(
            "Invalid value for {$name}."
        );
    }

    return trim($value);
}

function postNumber(
    string $name,
    float $default,
    float $minimum,
    float $maximum
): float {
    $value = postString($name);

    if ($value === '') {
        return $default;
    }

    if (!is_numeric($value)) {
        throw new InvalidArgumentException(
            "{$name} must be a number."
        );
    }

    $number = (float) $value;

    if (
        !is_finite($number)
        || $number < $minimum
        || $number > $maximum
    ) {
        throw new InvalidArgumentException(
            "{$name} must be between {$minimum} and {$maximum}."
        );
    }

    return $number;
}

function parseDate(
    string $value,
    DateTimeZone $timezone
): DateTimeImmutable {
    foreach (['m/d/Y', 'Y-m-d'] as $format) {
        $date = DateTimeImmutable::createFromFormat(
            '!' . $format,
            $value,
            $timezone
        );

        $errors = DateTimeImmutable::getLastErrors();

        if (
            $date !== false
            && (
                $errors === false
                || (
                    $errors['warning_count'] === 0
                    && $errors['error_count'] === 0
                )
            )
        ) {
            return $date;
        }
    }

    throw new InvalidArgumentException(
        'Enter dates as MM/DD/YYYY or YYYY-MM-DD.'
    );
}

function calendarText(string $value): string
{
    $value = str_replace(["\r\n", "\r"], "\n", $value);

    return str_replace(
        ['\\', ';', ',', "\n"],
        ['\\\\', '\\;', '\\,', '\\n'],
        $value
    );
}

/*
 * Fold content lines to at most 75 bytes, including the continuation
 * space, without splitting a UTF-8 character.
 */
function foldCalendarLine(string $line): string
{
    $parts = [];
    $limit = 75;

    while (strlen($line) > $limit) {
        $length = $limit;

        while (
            $length > 0
            && (ord($line[$length]) & 0xC0) === 0x80
        ) {
            $length--;
        }

        $parts[] = substr($line, 0, $length);
        $line = substr($line, $length);
        $limit = 74;
    }

    $parts[] = $line;

    return implode("\r\n ", $parts);
}

function renderCalendar(array $lines): string
{
    return implode(
        "\r\n",
        array_map('foldCalendarLine', $lines)
    ) . "\r\n";
}

function createCalendar(array $settings): string
{
    $timezone = $settings['timezone'];
    $utc = new DateTimeZone('UTC');
    $stamp = gmdate('Ymd\THis\Z');

    $lines = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//crow.black//Sunrise Sunset Calendar//EN',
        'CALSCALE:GREGORIAN',
        'METHOD:PUBLISH',
        'X-WR-CALNAME:' . calendarText(
            'Sunrise / Sunset: '
            . $settings['latitude']
            . ', '
            . $settings['longitude']
        ),
        'X-WR-TIMEZONE:' . $timezone->getName(),
    ];

    $day = $settings['start'];
    $dateCount = 0;

    while (
        $day <= $settings['end']
        && $dateCount < MAX_CALENDAR_DAYS
    ) {
        // Calculate once per date, not once per event.
        $sun = date_sun_info(
            $day->setTime(12, 0)->getTimestamp(),
            $settings['latitude'],
            $settings['longitude']
        );

        foreach (['sunrise', 'sunset'] as $type) {
            if (!$settings[$type]) {
                continue;
            }

            $timestamp = $sun[$type];

            /*
             * At some latitudes and times of year there is no
             * sunrise or sunset. PHP then returns a boolean.
             */
            if (!is_int($timestamp)) {
                continue;
            }

            $actual = (new DateTimeImmutable('@' . $timestamp))
                ->setTimezone($timezone);

            $offset = $settings[$type . '_offset'];
            $event = (new DateTimeImmutable(
                '@' . ($timestamp + $offset)
            ))->setTimezone($timezone);

            $summary = ucfirst($type)
                . ': '
                . $actual->format(
                    $settings['twelve'] ? 'h:i A' : 'H:i'
                );

            // The same location/date/event has a stable identifier.
            $uid = hash('sha256', implode('|', [
                $type,
                $day->format('Y-m-d'),
                (string) $settings['latitude'],
                (string) $settings['longitude'],
                $timezone->getName(),
            ])) . '@crow.black';

            $lines[] = 'BEGIN:VEVENT';
            $lines[] = 'UID:' . $uid;
            $lines[] = 'DTSTAMP:' . $stamp;
            $lines[] = 'SUMMARY:' . calendarText($summary);

            if ($settings['allday']) {
                $lines[] = 'DTSTART;VALUE=DATE:'
                    . $day->format('Ymd');

                // All-day DTEND is the exclusive end date.
                $lines[] = 'DTEND;VALUE=DATE:'
                    . $day->modify('+1 day')->format('Ymd');
            } else {
                $eventUtc = $event->setTimezone($utc);

                $lines[] = 'DTSTART:'
                    . $eventUtc->format('Ymd\THis\Z');

                $lines[] = 'DTEND:'
                    . $eventUtc->format('Ymd\THis\Z');
            }

            $lines[] = 'DESCRIPTION:'
                . calendarText($settings['description']);
            $lines[] = 'URL:' . CALENDAR_URL;
            $lines[] = 'END:VEVENT';
        }

        // Both progression and the iteration limit are unconditional.
        $day = $day->modify('+1 day');
        $dateCount++;
    }

    $lines[] = 'END:VCALENDAR';

    return renderCalendar($lines);
}

$isPost = ($_SERVER['REQUEST_METHOD'] ?? 'GET') === 'POST';
$errors = [];

$values = [
    'zone' => DEFAULT_TIMEZONE,
    'lat' => '',
    'lon' => '',
    'start' => '',
    'end' => '',
    'rise_off' => '',
    'set_off' => '',
    'description' => '',
];

$checked = [
    'sunrise' => false,
    'sunset' => false,
    'twelve' => false,
    'allday' => false,
];

$timezoneNames = DateTimeZone::listIdentifiers(
    DateTimeZone::ALL_WITH_BC
);

if ($isPost) {
    try {
        foreach ($values as $name => $default) {
            $values[$name] = postString($name, $default);
        }

        foreach ($checked as $name => $_) {
            $checked[$name] = isset($_POST[$name]);
        }

        if (!in_array($values['zone'], $timezoneNames, true)) {
            throw new InvalidArgumentException(
                'Select a valid timezone.'
            );
        }

        if (!$checked['sunrise'] && !$checked['sunset']) {
            throw new InvalidArgumentException(
                'Select sunrise, sunset, or both.'
            );
        }

        if (strlen($values['description']) > 10000) {
            throw new InvalidArgumentException(
                'The description must not exceed 10,000 bytes.'
            );
        }

        $timezone = new DateTimeZone($values['zone']);

        $start = $values['start'] === ''
            ? new DateTimeImmutable('today', $timezone)
            : parseDate($values['start'], $timezone);

        $latestEnd = $start->modify(
            '+' . (MAX_CALENDAR_DAYS - 1) . ' days'
        );

        $end = $values['end'] === ''
            ? $latestEnd
            : parseDate($values['end'], $timezone);

        if ($end < $start) {
            throw new InvalidArgumentException(
                'The end date must be on or after the start date.'
            );
        }

        if ($end > $latestEnd) {
            throw new InvalidArgumentException(
                'Choose no more than '
                . MAX_CALENDAR_DAYS
                . ' calendar dates, including the start date.'
            );
        }

        $settings = [
            'timezone' => $timezone,
            'start' => $start,
            'end' => $end,
						'latitude' => round(
								postNumber('lat', DEFAULT_LATITUDE, -90, 90),
								2
						),
						'longitude' => round(
								postNumber('lon', DEFAULT_LONGITUDE, -180, 180),
								2
						),
            // Offset limit: plus or minus 24 hours.
            'sunrise_offset' => (int) round(
                postNumber('rise_off', 0, -1440, 1440) * 60
            ),
            'sunset_offset' => (int) round(
                postNumber('set_off', 0, -1440, 1440) * 60
            ),
            'description' => $values['description'],
        ] + $checked;

        // Finish generation before sending download headers.
        $calendar = createCalendar($settings);

        header('Content-Type: text/calendar; charset=utf-8');
        header(
            'Content-Disposition: attachment; '
            . 'filename="ical_sun.ics"'
        );
        header('Cache-Control: no-store');
        header('X-Content-Type-Options: nosniff');

        echo $calendar;
        exit;
    } catch (InvalidArgumentException $exception) {
        http_response_code(400);
        $errors[] = $exception->getMessage();
    }
}

$portland = new DateTimeZone(DEFAULT_TIMEZONE);
$today = new DateTimeImmutable('today', $portland);

$localSun = date_sun_info(
    $today->setTime(12, 0)->getTimestamp(),
    DEFAULT_LATITUDE,
    DEFAULT_LONGITUDE
);

function localSunTime(
    int|bool $timestamp,
    DateTimeZone $timezone
): string {
    if (!is_int($timestamp)) {
        return 'No event today';
    }

    return (new DateTimeImmutable('@' . $timestamp))
        ->setTimezone($timezone)
        ->format('H:i');
}
